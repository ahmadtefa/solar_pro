# ---------------------------------------------------------------------------
# Kayan ERP backend configuration (copy to .env and adjust).
# NEVER commit a real .env: this file only documents the supported variables.
# ---------------------------------------------------------------------------

# Core
APP_NAME=Kayan ERP
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | test | production
DEBUG=true
ROOT_PATH=

# Database (PostgreSQL in every real deployment)
DATABASE_URL=postgresql+psycopg://kayan:kayan@localhost:5432/kayan
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Security - generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=20

# CORS: comma separated origins, or * for development only
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# Storage
STORAGE_DIR=/app/storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png,gif,webp,xlsx,xls,csv,doc,docx,txt,zip

# Backups
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_CRON=0 2 * * *

# Development bootstrap (dev only - rotate everything before production)
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_EMAIL=admin@kayan.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345

# Defaults for new companies
DEFAULT_CURRENCY_CODE=USD
DEFAULT_COUNTRY_CODE=US
DEFAULT_TIMEZONE=UTC
FISCAL_YEAR_START_MONTH=1
