         run: |
@@ -86,6 +88,34 @@ jobs:
       - name: Install dependencies
         run: bun install
 
+      - name: Verify agent credential
+        # Fail fast with an explicit message when the secret is missing/empty.
+        # Only the credential SHAPE is reported — never its value.
+        env:
+          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
+        run: |
+          if [ -z "${GEMINI_API_KEY}" ]; then
+            echo "::error::GEMINI_API_KEY is not set for this repository."
+            echo "Add it under Settings → Secrets and variables → Actions → Secrets,"
+            echo "then re-run this workflow. (Secret names are case-sensitive.)"
+            exit 1
+          fi
+          echo "GEMINI_API_KEY is present (${#GEMINI_API_KEY} characters)."
+          case "$GEMINI_API_KEY" in
+            AQ.*) echo "Key format: AI Studio auth key (AQ.) — sent via the x-goog-api-key header." ;;
+            AIza*) echo "Key format: legacy standard key (AIzaSy…). Google is retiring these;"
+                   echo "regenerate it in AI Studio if authentication keeps failing." ;;
+            *) echo "Key format: unrecognized. Verify the value came from AI Studio." ;;
+          esac
+
+      - name: Preflight (credential + model check)
+        # Probes the configured Gemini model so a bad key or a retired model id
+        # is reported as itself instead of surfacing later as a vague error.
+        env:
+          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
+          ISSUECLAW_LOG_LEVEL: ${{ vars.ISSUECLAW_LOG_LEVEL || 'info' }}
+        run: bun run src/lifecycle/preflight.ts
+
       - name: Run agent
         env:
           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
