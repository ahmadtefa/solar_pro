# Copy to .env before running: docker compose -f infrastructure/docker-compose.yml up --build
# Every value here is a placeholder: replace the secrets before any real deployment.
ENVIRONMENT=production
DEBUG=false
HTTP_PORT=8080
POSTGRES_DB=kayan
POSTGRES_USER=kayan
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=20
SEED_DEMO_DATA=false
BOOTSTRAP_ADMIN_EMAIL=admin@kayan.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
API_BASE_URL=/api/v1

# --- backend -------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO
JWT_ALGORITHM=HS256
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_ROUNDS=12
DEFAULT_CURRENCY_CODE=EGP
DEFAULT_COUNTRY_CODE=EG
DEFAULT_TIMEZONE=Africa/Cairo
FISCAL_YEAR_START_MONTH=1

# --- storage and uploads --------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png,gif,webp,xlsx,xls,csv,doc,docx,txt,zip

# --- backups -------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE_CRON=0 2 * * *

# --- frontend build ------------------------------------------------------------
API_BASE_URL=/api/v1
